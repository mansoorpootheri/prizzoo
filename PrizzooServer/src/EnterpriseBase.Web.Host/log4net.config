<?xml version="1.0" encoding="utf-8"?>

<log4net>
    <!-- Daily rolling file: one file per day -->
    <appender name="DailyRollingFileAppender" type="log4net.Appender.RollingFileAppender">
        <file value="../../../App_Data/Logs/App_" />
        <appendToFile value="true" />
        <rollingStyle value="Date" />
        <datePattern value="yyyy-MM-dd'.log'" />
        <staticLogFileName value="false" />
        <maxSizeRollBackups value="30" />
        <layout type="log4net.Layout.PatternLayout">
            <conversionPattern value="%-5level %date [TenantId:%-5thread] %-40.40logger - %message%newline" />
        </layout>
    </appender>

    <!-- Error-only file for quick error monitoring -->
    <appender name="ErrorFileAppender" type="log4net.Appender.RollingFileAppender">
        <file value="../../../App_Data/Logs/Errors.log" />
        <appendToFile value="true" />
        <rollingStyle value="Size" />
        <maximumFileSize value="10000KB" />
        <maxSizeRollBackups value="10" />
        <staticLogFileName value="true" />
        <filter type="log4net.Filter.LevelRangeFilter">
            <levelMin value="ERROR" />
            <levelMax value="FATAL" />
        </filter>
        <layout type="log4net.Layout.PatternLayout">
            <conversionPattern value="%-5level %date [%-5.5thread] %-40.40logger - %message%newline%exception" />
        </layout>
    </appender>

    <!-- Suppress noisy EF/ABP framework DEBUG logs, keep app logs -->
    <logger name="Microsoft">
        <level value="WARN" />
    </logger>
    <logger name="System">
        <level value="WARN" />
    </logger>
    <logger name="Abp">
        <level value="WARN" />
    </logger>

    <!-- Full debug for our application services -->
    <logger name="EnterpriseBase">
        <level value="DEBUG" />
    </logger>

    <root>
        <appender-ref ref="DailyRollingFileAppender" />
        <appender-ref ref="ErrorFileAppender" />
        <level value="DEBUG" />
    </root>
</log4net>
