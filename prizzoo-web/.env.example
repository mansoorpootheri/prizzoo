# Copy this to .env.local for local development overrides (gitignored).
# Production defaults live in .env.production (committed - see that file),
# loaded automatically by `next build`/`next start`. Next.js's load order:
# .env.$(NODE_ENV).local > .env.local > .env.$(NODE_ENV) > .env.

NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# Fallback coordinates used when the browser denies/lacks geolocation.
# Kozhikode, Kerala - the fixed MVP launch city (see CLAUDE.md).
NEXT_PUBLIC_DEFAULT_LATITUDE=11.2588
NEXT_PUBLIC_DEFAULT_LONGITUDE=75.7804
