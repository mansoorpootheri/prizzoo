# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# NEXT_PUBLIC_* values here end up inlined in the client bundle anyway, so
# they're not secret - committing this is what makes `next build`/`next
# start` (production mode) work out of the box without extra deploy steps.
# Never put non-NEXT_PUBLIC_ secrets in this file.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
